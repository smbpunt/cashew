# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 4

[**/{Dockerfile,Caddyfile,*.sh,Makefile,*.mk}]
indent_style = tab

[{compose.*yaml,.devcontainer/compose.*yaml,.github/**/*.yaml}]
indent_size = 2

[**.md]
indent_size = unset
indent_style = unset

# Bank statement fixtures: keep their exact bytes (encoding, trailing spaces), as the banks export them
[tests/Fixtures/Statement/**]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = false
