{% extends 'layout.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block content %}
{% if importing %}
    <twig:ImportsInProgress />
{% endif %}

{% if report %}
    {% set month_name = report.month|month_name %}

    <section aria-labelledby="month" class="flex flex-col gap-6">
        <twig:MonthNav :month="report.month" :previous="report.previousMonth" :next="report.nextMonth" route="app_dashboard" />

        {% for totals in report.totals %}
            <dl class="grid gap-4 sm:grid-cols-3" data-currency="{{ totals.currency }}">
                {% for tile in [
                    {label: 'dashboard.income', amount: totals.income, class: 'text-success'},
                    {label: 'dashboard.spending', amount: -totals.spending},
                    {label: 'dashboard.balance', amount: totals.balance, signed: true},
                ] %}
                    <twig:Card class="gap-1 px-6 py-5">
                        <dt class="text-sm text-muted-foreground">{{ tile.label|trans }}</dt>
                        <dd class="text-2xl font-semibold tracking-tight">
                            <twig:Money :amount="tile.amount" :currency="totals.currency" :signed="tile.signed ?? false" :class="tile.class ?? ''" />
                        </dd>
                    </twig:Card>
                {% endfor %}
            </dl>
        {% endfor %}

        {% for breakdown in report.categories|filter(breakdown => not breakdown.empty) %}
            <twig:Card class="gap-0 py-0" data-categories="{{ breakdown.currency }}">
                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b px-4 py-3 sm:px-6">
                    <h2 class="font-semibold">{{ 'dashboard.categories.title'|trans }}</h2>
                    {% if breakdown.fixedCharges != 0 %}
                        <p class="text-sm text-muted-foreground" data-fixed-charges>
                            {{ 'dashboard.categories.fixed_charges'|trans }}
                            <twig:Money :amount="breakdown.fixedCharges" :currency="breakdown.currency" class="font-medium text-foreground" />
                        </p>
                    {% endif %}
                </div>
                <ul class="divide-y">
                    {% for total in breakdown.categories %}
                        <li class="flex flex-col gap-1 px-4 py-2.5 sm:px-6" data-category="{{ total.category.name }}">
                            <div class="flex items-center justify-between gap-4">
                                <a href="{{ path('app_category_show', {id: total.category.id, month: report.month.key}) }}" class="flex items-center gap-2 text-sm font-medium hover:underline">
                                    <twig:CategoryIcon :category="total.category" />
                                    {{- total.category.name -}}
                                </a>
                                <twig:Money :amount="total.amount" :currency="breakdown.currency" signed class="text-sm font-medium" />
                            </div>
                            {% if total.children is not empty %}
                                <ul class="flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-muted-foreground">
                                    {% for child in total.children %}
                                        <li class="flex gap-1" data-category="{{ child.category.name }}">
                                            <a href="{{ path('app_category_show', {id: child.category.id, month: report.month.key}) }}" class="hover:underline">{{ child.category.name }}</a>
                                            <twig:Money :amount="child.amount" :currency="breakdown.currency" signed />
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                    {% if breakdown.uncategorizedSpending != 0 %}
                        <li class="flex items-center justify-between gap-4 px-4 py-2.5 text-sm text-muted-foreground sm:px-6" data-uncategorized>
                            <span>{{ 'dashboard.categories.uncategorized'|trans }}</span>
                            <twig:Money :amount="breakdown.uncategorizedSpending" :currency="breakdown.currency" />
                        </li>
                    {% endif %}
                </ul>
            </twig:Card>
        {% endfor %}

        {# The list changes within the frame: only it reloads, and the page keeps its scroll #}
        <turbo-frame id="transactions">
            {# The mode and the sort are remembered: what's shown isn't, and goes along #}
            {% set filter = enum('App\\Enum\\TransactionFilter') %}
            {% set query = {month: report.month.key, show: list.show is same as filter.All ? null : list.show.value} %}
            {% set unidentified_only = list.show is same as filter.Unidentified %}
            <twig:Card class="gap-0 py-0">
                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b px-4 py-3 sm:px-6">
                    <div class="flex items-center gap-2">
                        <h2 class="font-semibold">{{ 'dashboard.transactions'|trans }}</h2>
                        {% if unidentified > 0 or unidentified_only %}
                            <twig:Button
                                as="a"
                                variant="outline"
                                size="xs"
                                href="{{ path('app_dashboard', query|merge({show: unidentified_only ? null : 'unidentified'})) }}"
                                aria-current="{{ unidentified_only ? 'true' : 'false' }}"
                                class="aria-[current=true]:border-primary aria-[current=true]:bg-primary aria-[current=true]:text-primary-foreground"
                                data-show="unidentified"
                            >{{ 'dashboard.unidentified'|trans({count: unidentified}) }}</twig:Button>
                        {% endif %}
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        {% set sort_options = enum('App\\Enum\\TransactionSort').cases()|map(option => {
                            value: option.value,
                            label: option|trans,
                            href: path('app_dashboard', query|merge({sort: option.value})),
                            current: option == list.sort,
                        }) %}
                        <twig:ToggleGroup name="sort" label="{{ 'dashboard.sort.label'|trans }}" :options="sort_options" />

                        {% set mode_options = enum('App\\Enum\\TransactionListMode').cases()|map(option => {
                            value: option.value,
                            label: option|trans,
                            href: path('app_dashboard', query|merge({mode: option.value})),
                            current: option == list.mode,
                        }) %}
                        <twig:ToggleGroup name="mode" label="{{ 'dashboard.mode.label'|trans }}" :options="mode_options" />
                    </div>
                </div>

                {% if transactions is empty %}
                    <twig:EmptyState data-empty>
                        {{- (unidentified_only ? 'dashboard.all_identified' : 'dashboard.no_transactions')|trans({month: month_name}) -}}
                    </twig:EmptyState>
                {% elseif list.mode is same as enum('App\\Enum\\TransactionListMode').Detailed %}
                    <ul class="divide-y">
                        {% for transaction in transactions %}
                            {% set label = transaction.label|split("\n") %}
                            <li class="flex items-start gap-4 px-4 py-3 sm:px-6" data-transaction>
                                <time datetime="{{ transaction.date|date('Y-m-d') }}" class="w-12 shrink-0 pt-0.5 text-xs text-muted-foreground tabular-nums">
                                    {{- transaction.date|format_date(pattern: 'd MMM') -}}
                                </time>
                                <twig:CategoryIcon :category="transaction.effectiveCategory" class="mt-0.5" />
                                <div class="flex min-w-0 flex-1 flex-col gap-1">
                                    <div>
                                        {# The name the user knows it by first, over the whole label #}
                                        <p class="text-sm font-medium break-words">
                                            <a href="{{ path('app_transaction_show', {id: transaction.id}) }}" data-turbo-frame="_top" class="hover:underline">{{ transaction.named ? transaction.name : label|first }}</a>
                                        </p>
                                        {% for line in transaction.named ? label : label|slice(1) %}
                                            <p class="text-xs break-words text-muted-foreground">{{ line }}</p>
                                        {% endfor %}
                                    </div>
                                    <twig:TransactionDetails :transaction="transaction" />
                                </div>
                                <twig:Money :amount="transaction.amount" :currency="transaction.currency" signed class="text-sm font-medium" />
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <ul class="divide-y">
                        {% for transaction in transactions %}
                            {# The whole row leads to the transaction, its name the link #}
                            <li class="relative flex items-center gap-4 px-4 py-2.5 hover:bg-muted/50 sm:px-6" data-transaction>
                                <time datetime="{{ transaction.date|date('Y-m-d') }}" class="w-12 shrink-0 text-xs text-muted-foreground tabular-nums">
                                    {{- transaction.date|format_date(pattern: 'd MMM') -}}
                                </time>
                                <twig:CategoryIcon :category="transaction.effectiveCategory" />
                                <a href="{{ path('app_transaction_show', {id: transaction.id}) }}" data-turbo-frame="_top" class="min-w-0 flex-1 truncate text-sm font-medium outline-none after:absolute after:inset-0 focus-visible:after:ring-2 focus-visible:after:ring-ring/50 focus-visible:after:ring-inset" title="{{ transaction.oneLineLabel }}">{{ transaction.name }}</a>
                                <twig:Money :amount="transaction.amount" :currency="transaction.currency" signed class="text-sm font-medium" />
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </twig:Card>
        </turbo-frame>
    </section>
{% elseif not importing %}
    <twig:ImportPrompt :waitingUntil="waiting_for_month_end ? next_import_date : null" />
{% endif %}
{% endblock %}
