{% extends 'layout.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block content %}
{% if importing %}
    <twig:ImportsInProgress />
{% endif %}

{% if report %}
    {% set month_name = report.month|format_date(pattern: 'LLLL y')|capitalize %}

    <section aria-labelledby="month" class="flex flex-col gap-6">
        <div class="flex items-center justify-between gap-4">
            <h1 id="month" class="text-2xl font-bold tracking-tight">{{ month_name }}</h1>

            <nav class="flex items-center gap-1" aria-label="{{ 'dashboard.months'|trans }}">
                {% for link in [
                    {month: report.previousMonth, label: 'dashboard.previous_month', icon: 'm15 18-6-6 6-6', rel: 'prev'},
                    {month: report.nextMonth, label: 'dashboard.next_month', icon: 'm9 18 6-6-6-6', rel: 'next'},
                ] %}
                    {% set icon %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ link.icon }}"/></svg>{% endset %}
                    {% if link.month %}
                        <twig:Button as="a" variant="outline" size="icon" href="{{ path('app_dashboard', {month: link.month|date('Y-m')}) }}" rel="{{ link.rel }}" aria-label="{{ link.label|trans }}" title="{{ link.label|trans }}">{{ icon }}</twig:Button>
                    {% else %}
                        <twig:Button variant="outline" size="icon" disabled aria-label="{{ link.label|trans }}">{{ icon }}</twig:Button>
                    {% endif %}
                {% endfor %}
            </nav>
        </div>

        {% for totals in report.totals %}
            <dl class="grid gap-4 sm:grid-cols-3" data-currency="{{ totals.currency }}">
                {% for tile in [
                    {label: 'dashboard.income', amount: totals.income, class: 'text-success'},
                    {label: 'dashboard.spending', amount: -totals.spending},
                    {label: 'dashboard.balance', amount: totals.balance, signed: true},
                ] %}
                    <twig:Card class="gap-1 px-6 py-5">
                        <dt class="text-sm text-muted-foreground">{{ tile.label|trans }}</dt>
                        <dd class="text-2xl font-semibold tracking-tight">
                            <twig:Money :amount="tile.amount" :currency="totals.currency" :signed="tile.signed ?? false" :class="tile.class ?? ''" />
                        </dd>
                    </twig:Card>
                {% endfor %}
            </dl>
        {% endfor %}

        {% for breakdown in report.categories|filter(breakdown => not breakdown.empty) %}
            <twig:Card class="gap-0 py-0" data-categories="{{ breakdown.currency }}">
                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b px-4 py-3 sm:px-6">
                    <h2 class="font-semibold">{{ 'dashboard.categories.title'|trans }}</h2>
                    {% if breakdown.fixedCharges != 0 %}
                        <p class="text-sm text-muted-foreground" data-fixed-charges>
                            {{ 'dashboard.categories.fixed_charges'|trans }}
                            <twig:Money :amount="breakdown.fixedCharges" :currency="breakdown.currency" class="font-medium text-foreground" />
                        </p>
                    {% endif %}
                </div>
                <ul class="divide-y">
                    {% for total in breakdown.categories %}
                        <li class="flex flex-col gap-1 px-4 py-2.5 sm:px-6" data-category="{{ total.category.name }}">
                            <div class="flex items-center justify-between gap-4">
                                <a href="{{ path('app_category_show', {id: total.category.id, month: report.month|date('Y-m')}) }}" class="flex items-center gap-2 text-sm font-medium hover:underline">
                                    <twig:CategoryIcon :category="total.category" />
                                    {{- total.category.name -}}
                                </a>
                                <twig:Money :amount="total.amount" :currency="breakdown.currency" signed class="text-sm font-medium" />
                            </div>
                            {% if total.children is not empty %}
                                <ul class="flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-muted-foreground">
                                    {% for child in total.children %}
                                        <li class="flex gap-1" data-category="{{ child.category.name }}">
                                            <a href="{{ path('app_category_show', {id: child.category.id, month: report.month|date('Y-m')}) }}" class="hover:underline">{{ child.category.name }}</a>
                                            <twig:Money :amount="child.amount" :currency="breakdown.currency" signed />
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                    {% if breakdown.uncategorizedSpending != 0 %}
                        <li class="flex items-center justify-between gap-4 px-4 py-2.5 text-sm text-muted-foreground sm:px-6" data-uncategorized>
                            <span>{{ 'dashboard.categories.uncategorized'|trans }}</span>
                            <twig:Money :amount="breakdown.uncategorizedSpending" :currency="breakdown.currency" />
                        </li>
                    {% endif %}
                </ul>
            </twig:Card>
        {% endfor %}

        {# The mode switches within the frame: only the list reloads, and the page keeps its scroll #}
        <turbo-frame id="transactions">
            <twig:Card class="gap-0 py-0">
                <div class="flex items-center justify-between gap-4 border-b px-4 py-3 sm:px-6">
                    <h2 class="font-semibold">{{ 'dashboard.transactions'|trans }}</h2>

                    <div role="group" aria-label="{{ 'dashboard.mode.label'|trans }}" class="flex items-center gap-0.5 rounded-lg bg-muted p-0.5">
                        {% for option in enum('App\\Enum\\TransactionListMode').cases() %}
                            <twig:Button
                                as="a"
                                variant="ghost"
                                size="xs"
                                href="{{ path('app_dashboard', {month: report.month|date('Y-m'), mode: option.value}) }}"
                                aria-current="{{ option == mode ? 'true' : 'false' }}"
                                class="text-muted-foreground hover:bg-background/60 aria-[current=true]:bg-background aria-[current=true]:text-foreground aria-[current=true]:shadow-sm"
                                data-mode="{{ option.value }}"
                            >{{ ('dashboard.mode.' ~ option.value)|trans }}</twig:Button>
                        {% endfor %}
                    </div>
                </div>

                {% if report.transactions is empty %}
                    <p class="px-6 py-10 text-center text-sm text-muted-foreground">{{ 'dashboard.no_transactions'|trans({month: month_name}) }}</p>
                {% elseif mode.value == 'detailed' %}
                    <ul class="divide-y">
                        {% for transaction in report.transactions %}
                            {% set label = transaction.label|split("\n") %}
                            <li class="flex items-start gap-4 px-4 py-3 sm:px-6" data-transaction>
                                <time datetime="{{ transaction.date|date('Y-m-d') }}" class="w-12 shrink-0 pt-0.5 text-xs text-muted-foreground tabular-nums">
                                    {{- transaction.date|format_date(pattern: 'd MMM') -}}
                                </time>
                                <twig:CategoryIcon :category="transaction.effectiveCategory" class="mt-0.5" />
                                <div class="flex min-w-0 flex-1 flex-col gap-1">
                                    <div>
                                        <p class="text-sm font-medium break-words">{{ label|first }}</p>
                                        {% for line in label|slice(1) %}
                                            <p class="text-xs break-words text-muted-foreground">{{ line }}</p>
                                        {% endfor %}
                                    </div>
                                    <dl class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                        {% for term, value in {
                                            'dashboard.detail.account': transaction.account.label,
                                            'dashboard.detail.bank': transaction.account.bank.label,
                                            'dashboard.detail.bank_category': transaction.bankCategory,
                                            'dashboard.detail.series': transaction.recurring ? transaction.recurringSeries.name : null,
                                        }|filter(value => value) %}
                                            <div class="flex gap-1" data-detail="{{ term|split('.')|last }}">
                                                <dt class="font-medium">{{ term|trans }}</dt>
                                                <dd>{{ value }}</dd>
                                            </div>
                                        {% endfor %}
                                        <twig:TransactionCategory :transaction="transaction" key="transaction-category-{{ transaction.id }}" />
                                        {% if transaction.kind.value == 'deferred_card_purchase' %}
                                            <twig:Badge variant="secondary">{{ 'dashboard.detail.deferred_card_purchase'|trans }}</twig:Badge>
                                        {% endif %}
                                    </dl>
                                </div>
                                <twig:Money :amount="transaction.amount" :currency="transaction.currency" signed class="text-sm font-medium" />
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <ul class="divide-y">
                        {% for transaction in report.transactions %}
                            {% set label = transaction.oneLineLabel %}
                            <li class="flex items-center gap-4 px-4 py-2.5 sm:px-6" data-transaction>
                                <time datetime="{{ transaction.date|date('Y-m-d') }}" class="w-12 shrink-0 text-xs text-muted-foreground tabular-nums">
                                    {{- transaction.date|format_date(pattern: 'd MMM') -}}
                                </time>
                                <twig:CategoryIcon :category="transaction.effectiveCategory" />
                                <p class="min-w-0 flex-1 truncate text-sm font-medium" title="{{ label }}">{{ label }}</p>
                                <twig:Money :amount="transaction.amount" :currency="transaction.currency" signed class="text-sm font-medium" />
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </twig:Card>
        </turbo-frame>
    </section>
{% elseif not importing %}
    <twig:Card class="mx-auto w-full max-w-lg items-center px-6 py-12 text-center motion-safe:animate-in motion-safe:fade-in motion-safe:zoom-in-95">
        <div class="flex size-12 items-center justify-center rounded-full bg-muted text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-6"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
        </div>
        <div class="flex flex-col gap-2">
            <h1 class="text-xl font-semibold tracking-tight">{{ 'dashboard.empty.title'|trans }}</h1>
            <p class="text-sm text-balance text-muted-foreground">
                {% if waiting_for_month_end %}
                    {{ 'dashboard.empty.waiting_for_month_end'|trans({date: next_import_date|format_date('long')}) }}
                {% else %}
                    {{ 'dashboard.empty.description'|trans }}
                {% endif %}
            </p>
        </div>
        <twig:Button as="a" size="lg" href="{{ path('app_statement_import') }}">{{ 'dashboard.empty.import'|trans }}</twig:Button>
    </twig:Card>
{% endif %}
{% endblock %}
