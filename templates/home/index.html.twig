{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
<main class="relative isolate flex min-h-svh items-center justify-center overflow-hidden px-4 py-16">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[radial-gradient(var(--color-foreground)_1px,transparent_1px)] bg-size-[22px_22px] opacity-10 [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_70%)]"></div>
        <div class="absolute -top-40 left-1/2 size-[38rem] -translate-x-[75%] rounded-full bg-violet-500/30 blur-3xl dark:bg-violet-500/20 motion-safe:animate-pulse"></div>
        <div class="absolute -bottom-48 left-1/2 size-[34rem] -translate-x-[15%] rounded-full bg-amber-400/30 blur-3xl dark:bg-amber-400/10 motion-safe:animate-pulse [animation-delay:1.5s]"></div>
        <div class="absolute top-1/3 left-1/2 size-[22rem] -translate-x-1/2 rounded-full bg-fuchsia-500/20 blur-3xl dark:bg-fuchsia-500/15 motion-safe:animate-pulse [animation-delay:3s]"></div>
    </div>

    <twig:Card class="w-full max-w-3xl items-center gap-8 bg-card/70 px-6 py-12 text-center shadow-2xl shadow-violet-500/10 backdrop-blur-xl sm:px-12 sm:py-16 motion-safe:animate-in motion-safe:fade-in motion-safe:zoom-in-95 motion-safe:duration-700">
        <twig:Badge variant="outline" class="gap-2 bg-background/60 px-3 py-3">
            <span class="relative flex size-2">
                <span class="absolute inline-flex size-full rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping"></span>
                <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
            </span>
            Cashew
        </twig:Badge>

        <h1 class="text-4xl leading-tight font-black tracking-tighter text-balance sm:text-6xl">
            <span class="bg-linear-to-br from-violet-600 via-fuchsia-500 to-amber-500 bg-clip-text box-decoration-clone pb-[0.1em] text-transparent dark:from-violet-400 dark:via-fuchsia-400 dark:to-amber-300 soft:from-violet-700 soft:via-fuchsia-700 soft:to-amber-700">{{ 'home.headline'|trans }}</span>
        </h1>

        <p class="max-w-xl text-base text-balance text-muted-foreground sm:text-lg">{{ 'home.pitch'|trans }}</p>

        <ul class="grid w-full gap-3 text-start text-sm sm:grid-cols-3">
            {% for feature in ['statements', 'months', 'privacy'] %}
                <li class="rounded-lg border bg-background/60 px-4 py-3">
                    <p class="font-medium">{{ ('home.features.' ~ feature ~ '.title')|trans }}</p>
                    <p class="text-muted-foreground">{{ ('home.features.' ~ feature ~ '.description')|trans }}</p>
                </li>
            {% endfor %}
        </ul>

        <div class="flex items-center gap-3">
            <twig:Button as="a" href="{{ path('app_login') }}" size="lg" class="h-11 rounded-full px-6 text-base">{{ 'home.log_in'|trans }}</twig:Button>
            <twig:ThemeSwitcher size="icon-lg" class="rounded-full border bg-background/60 p-1 [&>button]:rounded-full" />
        </div>
    </twig:Card>
</main>
{% endblock %}
