{% extends 'base.html.twig' %}

{% block title %}{{ 'security.login.title'|trans }}{% endblock %}

{% block body %}
<main class="flex min-h-svh items-center justify-center px-4 py-16">
    <twig:Card class="w-full max-w-sm">
        <twig:Card:Header>
            <twig:Card:Title><h1>{{ 'security.login.title'|trans }}</h1></twig:Card:Title>
            <twig:Card:Description>{{ 'security.login.description'|trans }}</twig:Card:Description>
        </twig:Card:Header>

        <twig:Card:Content>
            {% if error %}
                <twig:Alert variant="destructive" class="mb-4" role="alert">
                    <twig:Alert:Description>{{ error.messageKey|trans(error.messageData, 'security') }}</twig:Alert:Description>
                </twig:Alert>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                    <twig:Label for="username">{{ 'security.login.login'|trans }}</twig:Label>
                    <twig:Input type="text" name="_username" id="username" value="{{ last_username }}" autocomplete="username" autocapitalize="none" required autofocus />
                </div>

                <div class="flex flex-col gap-2">
                    <twig:Label for="password">{{ 'security.login.password'|trans }}</twig:Label>
                    <twig:Input type="password" name="_password" id="password" autocomplete="current-password" required />
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <twig:Button type="submit" size="lg" class="w-full">{{ 'security.login.submit'|trans }}</twig:Button>
            </form>
        </twig:Card:Content>
    </twig:Card>
</main>
{% endblock %}
