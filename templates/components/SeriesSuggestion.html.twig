{% set series = this.series %}
{% set occurrences = this.occurrences %}
<li {{ attributes.defaults({class: 'flex flex-col gap-4 px-4 py-4 sm:px-6'}) }} data-series="{{ series.id }}">
    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
        <div class="flex min-w-0 flex-col gap-1">
            <p class="font-medium break-words">{{ series.name }}</p>
            <p class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                <twig:Badge variant="secondary">{{ series.periodicity|trans }}</twig:Badge>
                <twig:Badge variant="outline">{{ (series.income ? 'recurrence.income' : 'recurrence.spending')|trans }}</twig:Badge>
                <span>{{ series.account.label }}</span>
                <span>{{ 'review.series.confidence'|trans({confidence: series.confidence / 100}) }}</span>
            </p>
        </div>
        <twig:Money :amount="series.typicalAmount" :currency="series.currency" signed class="font-semibold" />
    </div>

    <details class="group text-sm">
        <summary class="cursor-pointer text-muted-foreground select-none hover:text-foreground">
            {{ 'review.series.occurrences'|trans({count: occurrences|length, last: series.lastSeenOn|format_date('medium')}) }}
        </summary>
        <ul class="mt-2 flex flex-col gap-1 border-s ps-3">
            {% for transaction in occurrences %}
                <li class="flex items-center gap-3 text-xs">
                    <time datetime="{{ transaction.date|date('Y-m-d') }}" class="w-20 shrink-0 text-muted-foreground tabular-nums">{{ transaction.date|format_date('medium') }}</time>
                    <span class="min-w-0 flex-1 truncate" title="{{ transaction.oneLineLabel }}">{{ transaction.oneLineLabel }}</span>
                    <twig:Money :amount="transaction.amount" :currency="transaction.currency" signed />
                </li>
            {% endfor %}
        </ul>
    </details>

    {{ form_start(form, {attr: {
        class: 'grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end',
        novalidate: 'novalidate',
        'data-action': 'live#action:prevent',
        'data-live-action-param': 'confirm',
    }}) }}
        {{ form_row(form.name) }}
        {{ form_row(form.category) }}
        <div class="flex gap-2">
            <twig:Button type="submit" data-loading="addAttribute(disabled)">{{ 'review.series.confirm'|trans }}</twig:Button>
            <twig:Button type="button" variant="ghost" data-action="live#action" data-live-action-param="reject" data-loading="addAttribute(disabled)">{{ 'review.series.reject'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
</li>
