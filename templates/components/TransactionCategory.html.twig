{% set series_category = transaction.seriesCategory %}
<div {{ attributes.defaults({class: 'flex gap-1'}) }} data-detail="category">
    <label for="transaction-category-{{ transaction.id }}" class="font-medium">{{ 'dashboard.detail.category'|trans }}</label>
    <select id="transaction-category-{{ transaction.id }}" data-model="categoryId"
        class="-my-0.5 max-w-72 rounded-md border border-transparent bg-transparent px-1 text-xs hover:border-input focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:outline-none [&>option]:bg-background"
    >
        <option value="">{{ series_category ? 'dashboard.detail.from_series'|trans({category: series_category.path}) : 'dashboard.detail.no_category'|trans }}</option>
        {% for category in this.choices %}
            <option value="{{ category.id }}" {% if category.id == categoryId %}selected{% endif %}>{{ category.path }}</option>
        {% endfor %}
    </select>
</div>
