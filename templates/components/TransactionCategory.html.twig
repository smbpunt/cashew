{% set series_category = transaction.seriesCategory %}
{% set counterparty_category = ofCounterparty ? null : transaction.counterparty.category ?? null %}
<div {{ attributes.defaults({class: 'flex gap-1'}) }} data-detail="category">
    <label for="transaction-category-{{ transaction.id }}" class="font-medium">{{ 'transaction.detail.category'|trans }}</label>
    <select id="transaction-category-{{ transaction.id }}" data-model="categoryId"
        class="-my-0.5 max-w-72 rounded-md border border-transparent bg-transparent px-1 text-xs hover:border-input focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:outline-none [&>option]:bg-background"
    >
        {# The one it inherits, unless it has its own #}
        <option value="">
            {%- if series_category -%}
                {{ 'transaction.detail.from_series'|trans({category: series_category.path}) }}
            {%- elseif counterparty_category -%}
                {{ 'transaction.detail.from_counterparty'|trans({category: counterparty_category.path}) }}
            {%- else -%}
                {{ 'transaction.detail.no_category'|trans }}
            {%- endif -%}
        </option>
        {% for category in this.choices %}
            <option value="{{ category.id }}" {% if category.id == categoryId %}selected{% endif %}>{{ category.path }}</option>
        {% endfor %}
    </select>
    {% if ofCounterparty %}
        <span data-category-scope>{{ 'transaction.detail.for_counterparty'|trans }}</span>
    {% endif %}
</div>
