{%- props
    ## int In minor units (cents), negative for a debit.
    amount,
    ## string ISO 4217 code.
    currency,
    ## bool Whether a credit gets a "+" and its color.
    signed = false
-%}
<span {{ attributes.defaults({class: html_classes('tabular-nums whitespace-nowrap', {'text-success': signed and amount > 0})}) }}>
    {{- signed and amount > 0 ? '+' -}}
    {{- amount|major_units(currency)|format_currency(currency) -}}
</span>
