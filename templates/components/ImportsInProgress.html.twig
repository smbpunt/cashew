{# Inside the blocks of the components below, "this" is them #}
{% set imports = this.imports %}
<div {{ attributes.defaults({class: 'block'}) }}
    {% if imports is not empty %}data-poll="delay(10000)|refresh"{% endif %}
>
    {% if imports is not empty %}
        <div hidden
            data-controller="statement-import-updates"
            data-statement-import-updates-url-value="{{ mercure(this.topics, {subscribe: this.topics}) }}"
        ></div>

        <twig:Alert>
            {{ ux_icon('lucide:loader-circle', {class: 'motion-safe:animate-spin', 'aria-hidden': 'true'}) }}
            <twig:Alert:Title>{{ 'dashboard.importing.title'|trans({count: imports|length}) }}</twig:Alert:Title>
            <twig:Alert:Description>
                <p>{{ 'dashboard.importing.description'|trans }}</p>
                <ul class="mt-1 flex flex-wrap gap-2">
                    {% for import in imports %}
                        <li><twig:Badge variant="secondary" class="max-w-64"><span class="truncate">{{ import.originalFilename }}</span></twig:Badge></li>
                    {% endfor %}
                </ul>
            </twig:Alert:Description>
        </twig:Alert>
    {% endif %}
</div>
