{%- props
    ## 'icon-xs'|'icon-sm'|'icon'|'icon-lg' The size of each button.
    size = 'icon-sm'
-%}
{# Which theme is chosen lives in the browser (localStorage): the theme controller marks it pressed on connect #}
{%- set icon = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' -%}
<div {{ attributes.defaults({class: 'flex items-center gap-0.5', role: 'group', 'aria-label': 'theme.label'|trans, 'data-controller': 'theme'}) }}>
    {% for theme, paths in {
        light: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
        soft: '<circle cx="12" cy="12" r="4"/><path d="M12 4h.01"/><path d="M20 12h.01"/><path d="M12 20h.01"/><path d="M4 12h.01"/><path d="M17.657 6.343h.01"/><path d="M17.657 17.657h.01"/><path d="M6.343 17.657h.01"/><path d="M6.343 6.343h.01"/>',
        dark: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
    } %}
        <twig:Button
            :size="size"
            variant="ghost"
            class="text-muted-foreground aria-pressed:border-muted-foreground aria-pressed:bg-muted aria-pressed:text-foreground"
            aria-label="{{ ('theme.' ~ theme)|trans }}"
            title="{{ ('theme.' ~ theme)|trans }}"
            aria-pressed="false"
            data-theme-target="option"
            data-theme-theme-param="{{ theme }}"
            data-action="theme#choose"
        >{# Our own markup, without user data #}<svg {{ icon|raw }}>{{ paths|raw }}</svg></twig:Button>
    {% endfor %}
</div>
