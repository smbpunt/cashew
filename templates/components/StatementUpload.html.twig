<div {{ attributes.defaults({class: 'flex flex-col gap-6'}) }}
    {% if this.processing %}data-poll="delay(10000)|refresh"{% endif %}
>
    {% if this.processing %}
        {# Removed with the last import in progress, which closes the Mercure connection #}
        <div hidden
            data-controller="statement-import-updates"
            data-statement-import-updates-url-value="{{ mercure(this.topics, {subscribe: this.topics}) }}"
        ></div>
    {% endif %}

    <div class="flex flex-col gap-1">
        {% if this.firstImport %}
            <p class="text-sm text-muted-foreground">
                Export the <strong class="font-medium text-foreground">full history</strong> of each of your accounts, from every bank, and drop the files below.
            </p>
        {% else %}
            <p class="text-sm text-muted-foreground">
                Once a month is over, export its statement and drop it below. Exports may overlap: transactions already imported are skipped.
            </p>
        {% endif %}
        <p class="text-sm text-muted-foreground">
            Supported: Crédit Agricole (CSV export) and Revolut (statement in French, CSV). Transactions are imported up to the end of the last whole month, {{ this.cutoffDate|date('F jS, Y') }}.
        </p>
    </div>

    {{ form_start(this.form, {attr: {
        class: 'flex flex-col gap-4',
        novalidate: 'novalidate',
        'data-action': 'live#action:prevent',
        'data-live-action-param': 'files|upload',
    }}) }}
        {# A new id on each upload re-renders the ignored dropzone, empty #}
        <div id="statement-dropzone-{{ uploads }}">
            <div data-live-ignore>
                {{ form_widget(this.form.statements) }}
            </div>
        </div>

        {% set errors = this.form.statements.vars.errors|map(error => error.message)|merge(uploadErrors) %}
        {% for child in this.form.statements.children %}
            {% set errors = errors|merge(child.vars.errors|map(error => error.message)) %}
        {% endfor %}
        {% if errors is not empty %}
            <twig:Alert variant="destructive" role="alert">
                <twig:Alert:Description>
                    <ul class="list-inside list-disc">
                        {% for error in errors %}<li>{{ error }}</li>{% endfor %}
                    </ul>
                </twig:Alert:Description>
            </twig:Alert>
        {% endif %}

        <twig:Button type="submit" class="self-start" data-loading="addAttribute(disabled)">
            <span data-loading="hide">Import</span>
            <span data-loading="show" hidden>Uploading…</span>
        </twig:Button>
    {{ form_end(this.form, {render_rest: false}) }}

    {% if this.imports is not empty %}
        <ul class="flex flex-col gap-2" aria-live="polite" aria-label="Imports">
            {% for import in this.imports %}
                <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-lg border px-4 py-3 text-sm" data-import-status="{{ import.status.value }}">
                    <span class="min-w-0 truncate font-medium">{{ import.originalFilename }}</span>
                    {% if import.status.value == 'pending' %}
                        <twig:Badge variant="secondary">Waiting…</twig:Badge>
                    {% elseif import.status.value == 'processing' %}
                        <twig:Badge variant="secondary">Importing…</twig:Badge>
                    {% elseif import.status.value == 'done' %}
                        <span class="flex flex-wrap items-center gap-2 text-muted-foreground">
                            <twig:Badge>{{ import.bank.label }}</twig:Badge>
                            {{ import.importedCount }} imported
                            {%- if import.skippedCount %}, {{ import.skippedCount }} already known{% endif %}
                            {%- if import.afterCutoffCount %}, {{ import.afterCutoffCount }} left for next month{% endif %}
                        </span>
                    {% else %}
                        <span class="flex flex-wrap items-center gap-2">
                            <twig:Badge variant="destructive">Failed</twig:Badge>
                            <span class="text-destructive">{{ import.error }}</span>
                        </span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
