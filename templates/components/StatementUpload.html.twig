<div {{ attributes.defaults({class: 'flex flex-col gap-6'}) }}
    {% if this.processing %}data-poll="delay(10000)|refresh"{% endif %}
>
    {% if this.processing %}
        {# Removed with the last import in progress, which closes the Mercure connection #}
        <div hidden
            data-controller="statement-import-updates"
            data-statement-import-updates-url-value="{{ mercure(this.topics, {subscribe: this.topics}) }}"
        ></div>
    {% endif %}

    {% if completed %}
        {% set next_url = this.nextUrl %}
        {% set review = next_url != path('app_dashboard') %}
        <div role="status" class="flex flex-col items-center gap-3 py-4 text-center"
            data-controller="import-complete"
            data-import-complete-url-value="{{ next_url }}"
            data-import-complete-delay-value="1800"
        >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="import-check size-16 text-success">
                <circle cx="26" cy="26" r="24"/>
                <path d="M15 27l7 7 15-15"/>
            </svg>
            <p class="text-lg font-semibold tracking-tight motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2 motion-safe:delay-500 motion-safe:fill-mode-both">{{ 'statement.import.completed.title'|trans }}</p>
            <p class="text-sm text-muted-foreground motion-safe:animate-in motion-safe:fade-in motion-safe:delay-700 motion-safe:fill-mode-both">
                {{ (review ? 'statement.import.completed.redirecting_review' : 'statement.import.completed.redirecting')|trans }}
                <a href="{{ next_url }}" class="font-medium text-foreground underline underline-offset-4">{{ (review ? 'statement.import.completed.review' : 'statement.import.completed.go')|trans }}</a>
            </p>
            <div aria-hidden="true" class="h-1 w-40 overflow-hidden rounded-full bg-muted">
                <div class="import-redirect-bar h-full rounded-full bg-success [--import-redirect-delay:1.8s]"></div>
            </div>
        </div>
    {% else %}
    <div class="flex flex-col gap-1 text-sm text-muted-foreground [&_strong]:font-medium [&_strong]:text-foreground">
        {# Our own catalogs, without user data: their markup is safe #}
        <p>{{ (this.firstImport ? 'statement.upload.intro.first' : 'statement.upload.intro.monthly')|trans|raw }}</p>
        <p>{{ 'statement.upload.intro.supported'|trans({cutoff: this.cutoffDate|format_date('long')}) }}</p>
    </div>

    {{ form_start(this.form, {attr: {
        class: 'flex flex-col gap-4',
        novalidate: 'novalidate',
        'data-action': 'live#action:prevent',
        'data-live-action-param': 'files|upload',
    }}) }}
        {# A new id on each upload re-renders the ignored dropzone, empty #}
        <div id="statement-dropzone-{{ uploads }}">
            <div data-live-ignore>
                {{ form_widget(this.form.statements) }}
            </div>
        </div>

        {% set errors = this.form.statements.vars.errors|map(error => error.message)|merge(uploadErrors) %}
        {% for child in this.form.statements.children %}
            {% set errors = errors|merge(child.vars.errors|map(error => error.message)) %}
        {% endfor %}
        {% if errors is not empty %}
            <twig:Alert variant="destructive" role="alert">
                <twig:Alert:Description>
                    <ul class="list-inside list-disc">
                        {% for error in errors %}<li>{{ error }}</li>{% endfor %}
                    </ul>
                </twig:Alert:Description>
            </twig:Alert>
        {% endif %}

        <twig:Button type="submit" class="self-start" data-loading="addAttribute(disabled)">
            <span data-loading="hide">{{ 'statement.upload.submit'|trans }}</span>
            <span data-loading="show" hidden>{{ 'statement.upload.uploading'|trans }}</span>
        </twig:Button>
    {{ form_end(this.form, {render_rest: false}) }}
    {% endif %}

    {% if this.processing %}
        <p class="text-sm text-muted-foreground">{{ 'statement.upload.leave'|trans }}</p>
    {% elseif this.imports is not empty and not completed %}
        <twig:Button as="a" variant="outline" href="{{ path('app_dashboard') }}" class="self-start">{{ 'statement.import.completed.go'|trans }}</twig:Button>
    {% endif %}

    {% if this.imports is not empty %}
        <ul class="flex flex-col gap-2" aria-live="polite" aria-label="{{ 'statement.upload.imports'|trans }}">
            {% for import in this.imports %}
                <twig:ImportResult :import="import" />
            {% endfor %}
        </ul>
    {% endif %}
</div>
