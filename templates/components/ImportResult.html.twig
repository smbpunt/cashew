{%- props
    ## App\Entity\StatementImport The import, in progress or over.
    import,
    ## The days of what it brought, already formatted; null to leave them out.
    period = null
-%}
<li {{ attributes.defaults({class: 'flex flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-lg border px-4 py-3 text-sm'}) }} data-import-status="{{ import.status.value }}">
    <span class="flex min-w-0 flex-col gap-0.5">
        <span class="truncate font-medium">{{ import.originalFilename }}</span>
        {% if period %}
            <span class="flex items-center gap-1.5" data-import-period>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                {{ period }}
            </span>
        {% endif %}
    </span>
    {% if import.status.value == 'done' %}
        <span class="flex flex-wrap items-center gap-2 text-muted-foreground">
            <twig:Badge>{{ import.bank.label }}</twig:Badge>
            {{ 'statement.import.result'|trans({imported: import.importedCount, skipped: import.skippedCount, after_cutoff: import.afterCutoffCount}) }}
        </span>
    {% elseif import.status.value == 'failed' %}
        <span class="flex flex-wrap items-center gap-2">
            <twig:Badge variant="destructive">{{ 'statement.import.status.failed'|trans }}</twig:Badge>
            <span class="text-destructive">{{ import.error|trans }}</span>
        </span>
    {% else %}
        <twig:Badge variant="secondary">{{ ('statement.import.status.' ~ import.status.value)|trans }}</twig:Badge>
    {% endif %}
</li>
