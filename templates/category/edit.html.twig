{% extends 'layout.html.twig' %}

{% block title %}{{ 'category.edit.title'|trans({name: category.name}) }}{% endblock %}

{% block content %}
<twig:Card class="mx-auto w-full max-w-lg">
    <twig:Card:Header>
        <twig:Card:Title><h1>{{ 'category.edit.title'|trans({name: category.name}) }}</h1></twig:Card:Title>
    </twig:Card:Header>
    <twig:Card:Content class="flex flex-col gap-6">
        {{ form_start(form, {attr: {class: 'flex flex-col gap-4', novalidate: 'novalidate'}}) }}
            <div class="flex flex-col gap-2">
                {{ form_label(form.name) }}
                <div class="flex gap-2">
                    <twig:IconPicker name="{{ field_name(form.icon) }}" :value="form.icon.vars.value ?: null" />
                    {{ form_widget(form.name) }}
                </div>
                {{ form_errors(form.name) }}
                {{ form_errors(form.icon) }}
            </div>
            {% do form.icon.setRendered %}
            {# A system category has no say in it, and form.parent would be the parent view then #}
            {% if form.children.parent is defined %}
                {{ form_row(form.children.parent) }}
            {% endif %}
            {{ form_rest(form) }}
            <div class="flex gap-2">
                <twig:Button type="submit">{{ 'category.edit.submit'|trans }}</twig:Button>
                <twig:Button as="a" variant="ghost" href="{{ path('app_categories') }}">{{ 'category.edit.cancel'|trans }}</twig:Button>
            </div>
        {{ form_end(form) }}

        {% if is_granted('CATEGORY_DELETE', category) %}
            <form method="post" action="{{ path('app_category_delete', {id: category.id}) }}" class="flex flex-wrap items-center justify-between gap-3 border-t pt-4"
                data-turbo-confirm="{{ 'category.delete.confirm'|trans({name: category.name}) }}"
            >
                <p class="text-sm text-muted-foreground">{{ 'category.delete.description'|trans({count: category.children|length}) }}</p>
                <input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}">
                <twig:Button type="submit" variant="destructive" size="sm">{{ 'category.delete.submit'|trans }}</twig:Button>
            </form>
        {% else %}
            <p class="border-t pt-4 text-sm text-muted-foreground" data-system-category>{{ 'category.delete.system'|trans }}</p>
        {% endif %}
    </twig:Card:Content>
</twig:Card>
{% endblock %}
