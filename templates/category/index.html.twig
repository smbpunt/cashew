{% extends 'layout.html.twig' %}

{% block title %}{{ 'category.title'|trans }}{% endblock %}

{% block content %}
<div class="flex flex-col gap-1">
    <h1 class="text-2xl font-bold tracking-tight">{{ 'category.title'|trans }}</h1>
    <p class="text-sm text-muted-foreground">{{ 'category.description'|trans }}</p>
</div>

{% if not has_categories %}
    {{ include('category/_seed.html.twig', {redirect: 'app_categories'}) }}
{% endif %}

<twig:Card>
    <twig:Card:Header>
        <twig:Card:Title><h2>{{ 'category.new'|trans }}</h2></twig:Card:Title>
    </twig:Card:Header>
    <twig:Card:Content>
        <twig:CategoryForm />
    </twig:Card:Content>
</twig:Card>

<twig:Card class="gap-0 py-0">
    <twig:CategoryTree />
</twig:Card>
{% endblock %}
