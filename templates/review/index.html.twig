{% extends 'layout.html.twig' %}

{% block title %}{{ 'review.title'|trans }}{% endblock %}

{% macro period(range, from_to, on) %}
    {%- set first = range[0]|format_date('medium') -%}
    {%- set last = range[1]|format_date('medium') -%}
    {%- if first == last -%}
        {{ on|trans({date: first}) }}
    {%- else -%}
        {{ from_to|trans({first: first, last: last}) }}
    {%- endif -%}
{% endmacro %}

{% block content %}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-bold tracking-tight">{{ 'review.title'|trans }}</h1>
        <p class="text-sm text-muted-foreground">{{ 'review.description'|trans }}</p>
    </div>
    <twig:Button as="a" href="{{ path('app_dashboard') }}">{{ 'review.continue'|trans }}</twig:Button>
</div>

<section aria-labelledby="new-category">
    <twig:Card>
        <twig:Card:Header>
            <twig:Card:Title><h2 id="new-category">{{ 'review.categories.title'|trans }}</h2></twig:Card:Title>
            <twig:Card:Description>{{ 'review.categories.description'|trans }}</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content class="flex flex-col gap-4">
            {% if not has_categories %}
                {{ include('category/_seed.html.twig', {from: 'review'}) }}
            {% endif %}
            <twig:CategoryForm />
        </twig:Card:Content>
    </twig:Card>
</section>

{% if imports is not empty %}
    <section aria-labelledby="imports" class="flex flex-col gap-3">
        <div class="flex flex-col gap-1">
            <h2 id="imports" class="font-semibold">{{ 'review.imports.title'|trans({count: imports|length}) }}</h2>
            {% if periods|length > 1 %}
                <p class="text-sm font-medium" data-imports-period>{{ _self.period(period, 'review.imports.all_from_to', 'review.imports.all_on') }}</p>
            {% endif %}
        </div>
        <ul class="flex flex-col gap-2">
            {% for import in imports %}
                <twig:ImportResult :import="import" :period="periods[import.id] is defined ? _self.period(periods[import.id], 'review.imports.from_to', 'review.imports.on') : null" />
            {% endfor %}
        </ul>
    </section>
{% endif %}

{% if amount_changes is not empty %}
    <section aria-labelledby="amount-changes">
        <twig:Alert>
            {{ ux_icon('lucide:triangle-alert', {'aria-hidden': 'true'}) }}
            <twig:Alert:Title><h2 id="amount-changes">{{ 'review.amount_changes.title'|trans({count: amount_changes|length}) }}</h2></twig:Alert:Title>
            <twig:Alert:Description>
                <ul class="flex flex-col gap-1">
                    {% for change in amount_changes %}
                        {% set transaction = change.transaction %}
                        <li data-amount-change>
                            {{ 'review.amount_changes.item'|trans({
                                series: transaction.recurringSeries.name,
                                date: transaction.date|format_date('medium'),
                                amount: transaction.amount|abs|money(transaction.currency),
                                previous: change.previousAmount|abs|money(transaction.currency),
                                previous_date: change.previousDate|format_date('medium'),
                            }) }}
                        </li>
                    {% endfor %}
                </ul>
            </twig:Alert:Description>
        </twig:Alert>
    </section>
{% endif %}

<twig:PendingSeries />

{% if transfers is not empty %}
    <section aria-labelledby="transfers">
        <twig:Card class="gap-0 py-0">
            <div class="flex flex-col gap-1 border-b px-4 py-3 sm:px-6">
                <h2 id="transfers" class="font-semibold">{{ 'review.transfers.title'|trans({count: transfers|length}) }}</h2>
                <p class="text-sm text-muted-foreground">{{ 'review.transfers.description'|trans({name: (transfers|first).category.name}) }}</p>
            </div>
            {# Folded: a few months bring hundreds of them, which would push the rest down #}
            <details class="group" data-transfers>
                <summary class="flex cursor-pointer list-none px-4 py-3 sm:px-6 [&::-webkit-details-marker]:hidden">
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-primary underline-offset-4 hover:underline">
                        {{ ux_icon('lucide:chevron-down', {'aria-hidden': 'true', class: 'size-4 transition-transform group-open:rotate-180'}) }}
                        <span class="group-open:hidden">{{ 'review.transfers.show'|trans({count: transfers|length}) }}</span>
                        <span class="hidden group-open:inline">{{ 'review.transfers.hide'|trans({count: transfers|length}) }}</span>
                    </span>
                </summary>
                <ul class="divide-y border-t">
                    {% for transaction in transfers %}
                        <li class="flex items-start gap-4 px-4 py-3 sm:px-6" data-transfer>
                            <time datetime="{{ transaction.date|date('Y-m-d') }}" class="w-12 shrink-0 pt-0.5 text-xs text-muted-foreground tabular-nums">
                                {{- transaction.date|format_date(pattern: 'd MMM') -}}
                            </time>
                            <div class="flex min-w-0 flex-1 flex-col gap-1">
                                <p class="text-sm font-medium break-words">{{ transaction.oneLineLabel }}</p>
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                    <span>{{ transaction.account.label }}</span>
                                    {% if transaction.internalTransfer %}
                                        <twig:Badge variant="secondary" data-internal>{{ 'review.transfers.internal'|trans }}</twig:Badge>
                                    {% else %}
                                        <twig:Badge variant="outline">{{ 'review.transfers.external'|trans }}</twig:Badge>
                                    {% endif %}
                                    <twig:TransactionCategory :transaction="transaction" key="transfer-category-{{ transaction.id }}" />
                                </div>
                            </div>
                            <twig:Money :amount="transaction.amount" :currency="transaction.currency" signed class="text-sm font-medium" />
                        </li>
                    {% endfor %}
                </ul>
            </details>
        </twig:Card>
    </section>
{% endif %}
{% endblock %}
